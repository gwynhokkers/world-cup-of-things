# Session: min 32 chars for cookie encryption
NUXT_SESSION_PASSWORD=your-session-secret-at-least-32-characters-long

# Dev auth stub (no OAuth): uncomment with `bun run dev` to auto sign in as a local DB user
# NUXT_DEV_STUB_AUTH=1
# Optional: NUXT_DEV_STUB_USER_EMAIL=dev@local.test NUXT_DEV_STUB_USER_NAME=Local Dev NUXT_DEV_STUB_USER_ROLE=admin

# OAuth (create app on GitHub / Google Cloud Console)
# nuxt-auth-utils expects NUXT_OAUTH_*; these are also supported:
NUXT_GITHUB_CLIENT_ID=
NUXT_GITHUB_CLIENT_SECRET=
NUXT_GOOGLE_CLIENT_ID=
NUXT_GOOGLE_CLIENT_SECRET=

# Admin roles: comma-separated provider user IDs (GitHub id, Google sub)
ADMIN_GITHUB_IDS=
ADMIN_GOOGLE_IDS=

# Public site URL (used in emails; set in production to your deployed origin, e.g. https://example.com)
NUXT_PUBLIC_SITE_URL=

# Resend (round-close notifications; optional — omit to skip sending)
NUXT_RESEND_API_KEY=
# Verified sender in Resend, e.g. "World Cup <notify@yourdomain.com>"
NUXT_RESEND_FROM=

# Cloudflare (production only)
# NUXT_HUB_CLOUDFLARE_DATABASE_ID=
# NUXT_HUB_CLOUDFLARE_BUCKET_NAME=
